<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Note de Frais — CST</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --cream: #f5f0e8;
        --ink: #1a1714;
        --ink-soft: #4a4540;
        --gold: #c9a84c;
        --gold-light: #e8d5a3;
        --rust: #b85c38;
        --paper: #faf7f2;
        --border: rgba(26, 23, 20, 0.12);
        --shadow: 0 4px 40px rgba(26, 23, 20, 0.08);
        --green: #2e7d52;
        --green-bg: #d4edda;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family: "DM Sans", sans-serif;
        background: var(--cream);
        color: var(--ink);
        min-height: 100vh;
      }

      /* HEADER */
      header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 48px;
        height: 72px;
        background: rgba(245, 240, 232, 0.9);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .logo {
        font-family: "Playfair Display", serif;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--ink);
        text-decoration: none;
      }
      .logo span {
        color: var(--gold);
        font-style: italic;
      }
      .user-btn {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--ink);
        color: var(--cream);
        border: none;
        border-radius: 100px;
        padding: 10px 20px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition:
          background 0.2s,
          transform 0.15s;
      }
      .user-btn:hover {
        background: var(--ink-soft);
        transform: translateY(-1px);
      }
      .user-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--ink);
      }
      .dropdown {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: var(--shadow);
        min-width: 200px;
        overflow: hidden;
        display: none;
        animation: fadeDown 0.2s ease;
      }
      .dropdown.open {
        display: block;
      }
      @keyframes fadeDown {
        from {
          opacity: 0;
          transform: translateY(-8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .dropdown-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        font-size: 0.875rem;
        color: var(--ink);
        cursor: pointer;
        transition: background 0.15s;
        border: none;
        background: none;
        width: 100%;
        font-family: "DM Sans", sans-serif;
        text-align: left;
      }
      .dropdown-item:hover {
        background: var(--cream);
      }
      .dropdown-item.danger {
        color: var(--rust);
      }
      .dropdown-divider {
        height: 1px;
        background: var(--border);
        margin: 4px 0;
      }

      /* HERO */
      .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 120px 48px 80px;
        position: relative;
        overflow: hidden;
      }
      .hero::before {
        content: "";
        position: absolute;
        top: -20%;
        right: -10%;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          var(--gold-light) 0%,
          transparent 70%
        );
        opacity: 0.4;
      }
      .hero::after {
        content: "";
        position: absolute;
        bottom: 10%;
        left: -5%;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: radial-gradient(circle, #d4c5b0 0%, transparent 70%);
        opacity: 0.3;
      }
      .hero-content {
        max-width: 760px;
        text-align: center;
        position: relative;
        z-index: 1;
        animation: heroIn 0.8s ease both;
      }
      @keyframes heroIn {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 100px;
        padding: 6px 16px;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--ink-soft);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 32px;
      }
      .hero-eyebrow::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--gold);
      }
      .hero h1 {
        font-family: "Playfair Display", serif;
        font-size: clamp(2.8rem, 7vw, 5rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.02em;
        margin-bottom: 28px;
        color: var(--ink);
      }
      .hero h1 em {
        font-style: italic;
        color: var(--gold);
      }
      .hero p {
        font-size: 1.1rem;
        font-weight: 300;
        color: var(--ink-soft);
        line-height: 1.7;
        max-width: 520px;
        margin: 0 auto 48px;
      }
      .hero-cta {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--ink);
        color: var(--cream);
        border: none;
        border-radius: 100px;
        padding: 16px 32px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition:
          background 0.2s,
          transform 0.15s;
      }
      .btn-primary:hover {
        background: var(--ink-soft);
        transform: translateY(-2px);
      }
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        color: var(--ink);
        border: 1.5px solid var(--border);
        border-radius: 100px;
        padding: 16px 32px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition:
          border-color 0.2s,
          background 0.2s,
          transform 0.15s;
      }
      .btn-secondary:hover {
        border-color: var(--ink);
        background: var(--paper);
        transform: translateY(-2px);
      }

      /* INVOICES SECTION */
      .invoices-section {
        padding: 80px 48px;
        max-width: 1200px;
        margin: 0 auto;
      }
      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
      }
      .section-title {
        font-family: "Playfair Display", serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--ink);
      }
      .section-title span {
        font-size: 0.9rem;
        font-family: "DM Sans", sans-serif;
        font-weight: 400;
        color: var(--ink-soft);
        display: block;
        margin-top: 4px;
      }
      .btn-generate {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--gold);
        color: var(--ink);
        border: none;
        border-radius: 100px;
        padding: 14px 28px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition:
          background 0.2s,
          transform 0.15s,
          box-shadow 0.2s;
        box-shadow: 0 4px 20px rgba(201, 168, 76, 0.3);
      }
      .btn-generate:hover {
        background: #b8963c;
        transform: translateY(-2px);
        box-shadow: 0 6px 28px rgba(201, 168, 76, 0.4);
      }
      .invoice-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
      }
      .invoice-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 28px;
        transition:
          transform 0.2s,
          box-shadow 0.2s;
        animation: cardIn 0.4s ease both;
      }
      .invoice-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(26, 23, 20, 0.1);
      }
      @keyframes cardIn {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .invoice-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 20px;
      }
      .invoice-icon {
        width: 44px;
        height: 44px;
        background: var(--cream);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
      }
      .btn-delete-invoice {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: transparent;
        border: 1.5px solid var(--border);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ink-soft);
        font-size: 0.9rem;
        transition: all 0.2s;
        flex-shrink: 0;
      }
      .btn-delete-invoice:hover {
        background: var(--rust);
        border-color: var(--rust);
        color: #fff;
        transform: scale(1.1);
      }
      .invoice-name {
        font-family: "Playfair Display", serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 6px;
      }
      .invoice-budget {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 100px;
        background: var(--gold-light);
        color: var(--ink);
        margin-bottom: 12px;
      }
      .invoice-total {
        font-family: "Playfair Display", serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 4px;
      }
      .invoice-total span {
        font-size: 1rem;
        font-weight: 400;
      }
      .invoice-id {
        font-size: 0.8rem;
        color: var(--ink-soft);
        font-weight: 400;
        margin-bottom: 20px;
      }
      .invoice-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 20px;
        border-top: 1px solid var(--border);
      }
      .invoice-date {
        font-size: 0.8rem;
        color: var(--ink-soft);
      }
      .invoice-choix {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 100px;
      }
      .choix-remboursement {
        background: var(--green-bg);
        color: var(--green);
      }
      .choix-abandon {
        background: #fff3cd;
        color: #856404;
      }
      .empty-state {
        text-align: center;
        padding: 80px 24px;
        grid-column: 1/-1;
      }
      .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 20px;
        opacity: 0.4;
      }
      .empty-state h3 {
        font-family: "Playfair Display", serif;
        font-size: 1.4rem;
        margin-bottom: 8px;
        color: var(--ink-soft);
      }
      .empty-state p {
        font-size: 0.9rem;
        color: var(--ink-soft);
        opacity: 0.7;
      }

      /* MODAL BASE */
      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(26, 23, 20, 0.5);
        backdrop-filter: blur(4px);
        z-index: 200;
        display: none;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.2s ease;
        padding: 20px;
        overflow-y: auto;
      }
      .modal-overlay.open {
        display: flex;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      .modal {
        background: var(--paper);
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        max-width: 440px;
        position: relative;
        animation: slideUp 0.3s ease;
        margin: auto;
      }
      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .modal-close {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--cream);
        border: 1px solid var(--border);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: var(--ink-soft);
        transition: background 0.15s;
      }
      .modal-close:hover {
        background: var(--border);
      }
      .modal h2 {
        font-family: "Playfair Display", serif;
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 8px;
      }
      .modal-sub {
        font-size: 0.875rem;
        color: var(--ink-soft);
        margin-bottom: 32px;
      }
      .modal-tabs {
        display: flex;
        gap: 4px;
        background: var(--cream);
        border-radius: 100px;
        padding: 4px;
        margin-bottom: 28px;
      }
      .modal-tab {
        flex: 1;
        padding: 9px;
        border-radius: 100px;
        border: none;
        background: transparent;
        font-family: "DM Sans", sans-serif;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        color: var(--ink-soft);
        transition: all 0.2s;
      }
      .modal-tab.active {
        background: var(--paper);
        color: var(--ink);
        box-shadow: 0 2px 8px rgba(26, 23, 20, 0.1);
      }
      .form-group {
        margin-bottom: 16px;
      }
      .form-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--ink-soft);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 8px;
      }
      .form-input {
        width: 100%;
        padding: 13px 16px;
        background: var(--cream);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.95rem;
        color: var(--ink);
        outline: none;
        transition: border-color 0.2s;
      }
      .form-input:focus {
        border-color: var(--gold);
      }
      .form-select {
        width: 100%;
        padding: 13px 16px;
        background: var(--cream);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.95rem;
        color: var(--ink);
        outline: none;
        appearance: none;
        cursor: pointer;
      }
      .form-select:focus {
        border-color: var(--gold);
      }
      .form-submit {
        width: 100%;
        padding: 14px;
        background: var(--ink);
        color: var(--cream);
        border: none;
        border-radius: 12px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        margin-top: 8px;
        transition:
          background 0.2s,
          transform 0.15s;
      }
      .form-submit:hover {
        background: var(--ink-soft);
        transform: translateY(-1px);
      }
      .form-feedback {
        font-size: 0.85rem;
        color: var(--rust);
        text-align: center;
        margin-top: 12px;
        min-height: 20px;
      }
      .form-feedback.success {
        color: var(--green);
      }

      /* INVOICE CREATE MODAL — large */
      .modal-large {
        max-width: 860px;
        padding: 40px;
      }
      .invoice-form-section {
        margin-bottom: 32px;
      }
      .invoice-form-section h3 {
        font-family: "Playfair Display", serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
      }
      .form-row {
        display: grid;
        gap: 12px;
        margin-bottom: 12px;
      }
      .form-row.cols-2 {
        grid-template-columns: 1fr 1fr;
      }
      .form-row.cols-3 {
        grid-template-columns: 1fr 1fr 1fr;
      }

      /* TABLE DÉPENSES */
      .depenses-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        margin-bottom: 8px;
      }
      .depenses-table th {
        background: var(--cream);
        font-weight: 500;
        font-size: 0.75rem;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 10px 8px;
        border: 1px solid var(--border);
        text-align: left;
      }
      .depenses-table td {
        padding: 6px 6px;
        border: 1px solid var(--border);
        vertical-align: middle;
      }
      .depenses-table td input {
        width: 100%;
        padding: 6px 8px;
        background: var(--cream);
        border: 1px solid transparent;
        border-radius: 6px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.85rem;
        color: var(--ink);
        outline: none;
        transition: border-color 0.2s;
      }
      .depenses-table td input:focus {
        border-color: var(--gold);
      }
      .depenses-table td.km-col input {
        width: 100%;
      }
      .btn-remove-row {
        background: transparent;
        border: none;
        cursor: pointer;
        color: var(--ink-soft);
        font-size: 1rem;
        padding: 4px;
        border-radius: 4px;
        transition: color 0.2s;
      }
      .btn-remove-row:hover {
        color: var(--rust);
      }
      .btn-add-row {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        border: 1.5px dashed var(--border);
        border-radius: 8px;
        padding: 8px 16px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.85rem;
        color: var(--ink-soft);
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 8px;
      }
      .btn-add-row:hover {
        border-color: var(--gold);
        color: var(--ink);
        background: var(--cream);
      }
      .bareme-line {
        font-size: 0.8rem;
        color: var(--ink-soft);
        margin-top: 4px;
        font-style: italic;
      }
      .total-line {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 16px;
        margin-top: 16px;
        padding-top: 12px;
        border-top: 2px solid var(--ink);
      }
      .total-line span {
        font-family: "Playfair Display", serif;
        font-size: 1.2rem;
        font-weight: 700;
      }
      .total-label {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      /* CHOIX */
      .choix-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .choix-option {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        background: var(--cream);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .choix-option:hover {
        border-color: var(--gold);
      }
      .choix-option input[type="radio"] {
        margin-top: 2px;
        accent-color: var(--gold);
        cursor: pointer;
      }
      .choix-option label {
        cursor: pointer;
        flex: 1;
      }
      .choix-option label strong {
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 4px;
      }
      .choix-option label p {
        font-size: 0.8rem;
        color: var(--ink-soft);
        line-height: 1.5;
      }
      .choix-option.selected {
        border-color: var(--gold);
        background: rgba(201, 168, 76, 0.06);
      }
      .choix-extra {
        margin-top: 12px;
        display: none;
        animation: fadeIn 0.2s ease;
      }
      .choix-extra.visible {
        display: block;
      }

      /* UPLOAD */
      .upload-zone {
        border: 2px dashed var(--border);
        border-radius: 12px;
        padding: 32px 24px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        background: var(--cream);
      }
      .upload-zone:hover,
      .upload-zone.dragover {
        border-color: var(--gold);
        background: rgba(201, 168, 76, 0.05);
      }
      .upload-zone-icon {
        font-size: 2rem;
        margin-bottom: 12px;
        opacity: 0.5;
      }
      .upload-zone p {
        font-size: 0.875rem;
        color: var(--ink-soft);
      }
      .upload-zone p strong {
        color: var(--gold);
      }
      .upload-list {
        margin-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .upload-item {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.8rem;
      }
      .upload-item-name {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--ink);
      }
      .upload-item-size {
        color: var(--ink-soft);
        font-size: 0.75rem;
      }
      .btn-remove-file {
        background: transparent;
        border: none;
        cursor: pointer;
        color: var(--ink-soft);
        font-size: 0.9rem;
        padding: 2px;
        border-radius: 4px;
        transition: color 0.2s;
      }
      .btn-remove-file:hover {
        color: var(--rust);
      }

      /* SIGNATURE */
      .signature-zone {
        border: 1.5px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
      }
      canvas#sigCanvas {
        display: block;
        width: 100%;
        height: 140px;
        cursor: crosshair;
        touch-action: none;
      }
      .sig-controls {
        display: flex;
        gap: 8px;
        padding: 8px 12px;
        background: var(--cream);
        border-top: 1px solid var(--border);
      }
      .sig-btn {
        padding: 6px 14px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: transparent;
        font-family: "DM Sans", sans-serif;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.15s;
        color: var(--ink-soft);
      }
      .sig-btn:hover {
        background: var(--paper);
        color: var(--ink);
      }
      .sig-btn.active {
        background: var(--ink);
        color: var(--cream);
        border-color: var(--ink);
      }

      /* CONFIRMATION DELETE MODAL */
      .modal-confirm {
        max-width: 380px;
      }
      .modal-confirm .confirm-icon {
        font-size: 2.5rem;
        text-align: center;
        margin-bottom: 16px;
      }
      .modal-confirm h2 {
        text-align: center;
        font-size: 1.3rem;
      }
      .modal-confirm p {
        font-size: 0.875rem;
        color: var(--ink-soft);
        text-align: center;
        margin-bottom: 28px;
      }
      .confirm-actions {
        display: flex;
        gap: 12px;
      }
      .btn-cancel {
        flex: 1;
        padding: 12px;
        background: var(--cream);
        color: var(--ink);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-cancel:hover {
        background: var(--paper);
      }
      .btn-confirm-delete {
        flex: 1;
        padding: 12px;
        background: var(--rust);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-confirm-delete:hover {
        background: #9e4a2a;
        transform: translateY(-1px);
      }

      /* FOOTER */
      footer {
        background: var(--ink);
        color: var(--cream);
        padding: 60px 48px 32px;
        margin-top: 80px;
      }
      .footer-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 48px;
        padding-bottom: 48px;
        border-bottom: 1px solid rgba(245, 240, 232, 0.15);
      }
      .footer-brand .logo {
        color: var(--cream);
      }
      .footer-brand .logo span {
        color: var(--gold);
      }
      .footer-brand p {
        font-size: 0.875rem;
        color: rgba(245, 240, 232, 0.6);
        line-height: 1.7;
        margin-top: 16px;
        max-width: 280px;
      }
      .footer-col h4 {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(245, 240, 232, 0.5);
        margin-bottom: 20px;
      }
      .footer-col a {
        display: block;
        font-size: 0.875rem;
        color: rgba(245, 240, 232, 0.75);
        text-decoration: none;
        margin-bottom: 12px;
        transition: color 0.15s;
      }
      .footer-col a:hover {
        color: var(--cream);
      }
      .footer-bottom {
        max-width: 1200px;
        margin: 28px auto 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.8rem;
        color: rgba(245, 240, 232, 0.4);
      }
      .footer-bottom-links {
        display: flex;
        gap: 24px;
      }
      .footer-bottom-links a {
        color: rgba(245, 240, 232, 0.4);
        text-decoration: none;
        transition: color 0.15s;
      }
      .footer-bottom-links a:hover {
        color: rgba(245, 240, 232, 0.8);
      }

      /* TOAST */
      .toast {
        position: fixed;
        bottom: 32px;
        right: 32px;
        background: var(--ink);
        color: var(--cream);
        padding: 14px 22px;
        border-radius: 12px;
        font-size: 0.875rem;
        box-shadow: 0 8px 32px rgba(26, 23, 20, 0.2);
        z-index: 999;
        transform: translateY(20px);
        opacity: 0;
        transition: all 0.3s ease;
        pointer-events: none;
      }
      .toast.show {
        transform: translateY(0);
        opacity: 1;
      }

      /* LOADING OVERLAY */
      .loading-overlay {
        position: fixed;
        inset: 0;
        background: rgba(26, 23, 20, 0.6);
        backdrop-filter: blur(4px);
        z-index: 500;
        display: none;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 16px;
      }
      .loading-overlay.open {
        display: flex;
      }
      .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(245, 240, 232, 0.3);
        border-top-color: var(--gold);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .loading-overlay p {
        color: var(--cream);
        font-size: 0.9rem;
      }

      @media (max-width: 768px) {
        header {
          padding: 0 20px;
        }
        .hero {
          padding: 100px 24px 60px;
        }
        .invoices-section {
          padding: 60px 24px;
        }
        .modal-large {
          padding: 24px;
        }
        .form-row.cols-2,
        .form-row.cols-3 {
          grid-template-columns: 1fr;
        }
        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: 32px;
        }
        footer {
          padding: 48px 24px 24px;
        }
      }
    </style>
  </head>
  <body>
    <!-- HEADER -->
    <header>
      <a href="/" class="logo">Note de <span>Frais</span></a>
      <div style="position: relative">
        <button class="user-btn" id="userBtn">
          <div class="user-avatar" id="userAvatar">?</div>
          <span id="userBtnLabel">Mon compte</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path
              d="M3 5l4 4 4-4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
        <div class="dropdown" id="userDropdown"></div>
      </div>
    </header>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-content" id="heroContent"></div>
    </section>

    <!-- INVOICES -->
    <section
      class="invoices-section"
      id="invoicesSection"
      style="display: none"
    >
      <div class="section-header">
        <div class="section-title">
          Mes notes de frais
          <span>Retrouvez l'ensemble de vos documents</span>
        </div>
        <button class="btn-generate" id="btnGenerateInvoice">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path
              d="M8 3v10M3 8h10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          Nouvelle note de frais
        </button>
      </div>
      <div class="invoice-grid" id="invoiceGrid"></div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo">Note de <span>Frais</span></a>
          <p>
            Gérez et transmettez vos notes de frais professionnelles au CST
            simplement et efficacement.
          </p>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <a href="mailto:tresorier@troglos.fr">tresorier@troglos.fr</a>
        </div>
        <div class="footer-col">
          <h4>Liens</h4>
          <a href="#">CGU</a><a href="#">Mentions légales</a>
        </div>
        <div class="footer-col">
          <h4>CST</h4>
          <a href="#">Accueil</a><a href="#">À propos</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2025 CST — Tous droits réservés.</span>
        <div class="footer-bottom-links">
          <a href="#">Mentions légales</a>
          <a href="#">Politique de confidentialité</a>
        </div>
      </div>
    </footer>

    <!-- AUTH MODAL -->
    <div class="modal-overlay" id="authModal">
      <div class="modal">
        <button class="modal-close" id="authModalClose">✕</button>
        <h2 id="authModalTitle">Bienvenue</h2>
        <p class="modal-sub" id="authModalSub">
          Connectez-vous pour accéder à vos notes de frais.
        </p>
        <div class="modal-tabs">
          <button
            class="modal-tab active"
            id="tabLogin"
            onclick="switchTab('login')"
          >
            Se connecter
          </button>
          <button
            class="modal-tab"
            id="tabRegister"
            onclick="switchTab('register')"
          >
            S'inscrire
          </button>
        </div>
        <div id="loginForm">
          <div class="form-group">
            <label class="form-label">Adresse e-mail</label>
            <input
              class="form-input"
              type="email"
              id="loginEmail"
              placeholder="vous@exemple.com"
            />
          </div>
          <div class="form-group">
            <label class="form-label">Mot de passe</label>
            <input
              class="form-input"
              type="password"
              id="loginPassword"
              placeholder="••••••••"
            />
          </div>
          <button class="form-submit" onclick="doLogin()">Se connecter</button>
          <div class="form-feedback" id="loginFeedback"></div>
        </div>
        <div id="registerForm" style="display: none">
          <div class="form-group">
            <label class="form-label">Adresse e-mail</label>
            <input
              class="form-input"
              type="email"
              id="regEmail"
              placeholder="vous@exemple.com"
            />
          </div>
          <div class="form-group">
            <label class="form-label">Mot de passe</label>
            <input
              class="form-input"
              type="password"
              id="regPassword"
              placeholder="Minimum 6 caractères"
            />
          </div>
          <button class="form-submit" onclick="doRegister()">
            Créer mon compte
          </button>
          <div class="form-feedback" id="registerFeedback"></div>
        </div>
      </div>
    </div>

    <!-- INVOICE CREATE MODAL -->
    <div class="modal-overlay" id="invoiceModal">
      <div class="modal modal-large">
        <button class="modal-close" id="invoiceModalClose">✕</button>
        <h2>Nouvelle note de frais</h2>
        <p class="modal-sub">
          Remplissez le formulaire ci-dessous. Il sera converti en document PDF
          professionnel.
        </p>

        <!-- Section 1 : Demandeur -->
        <div class="invoice-form-section">
          <h3>Informations du demandeur</h3>
          <table class="depenses-table" style="margin-bottom: 0">
            <thead>
              <tr>
                <th>Nom du demandeur</th>
                <th>Date de la demande</th>
                <th>Raison de la dépense</th>
                <th>Budget</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <input
                    type="text"
                    id="nomDemandeur"
                    placeholder="Jean Dupont"
                  />
                </td>
                <td><input type="date" id="dateDemande" /></td>
                <td>
                  <input
                    type="text"
                    id="raisonDepense"
                    placeholder="Déplacement réunion"
                  />
                </td>
                <td>
                  <select
                    class="form-select"
                    id="budget"
                    style="
                      padding: 6px 8px;
                      font-size: 0.85rem;
                      border-radius: 6px;
                    "
                  >
                    <option value="">Choisir…</option>
                    <option value="Administratif">Administratif</option>
                    <option value="Bibliothèque">Bibliothèque</option>
                    <option value="Matos explo / spéléo / canyon">
                      Matos explo / spéléo / canyon
                    </option>
                    <option value="Matos autre">Matos autre</option>
                    <option value="Week-end et sorties">
                      Week-end et sorties
                    </option>
                  </select>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Section 2 : Dépenses -->
        <div class="invoice-form-section">
          <h3>Détail des dépenses</h3>
          <div style="overflow-x: auto">
            <table class="depenses-table" id="depensesTable">
              <thead>
                <tr>
                  <th>Date de la dépense</th>
                  <th>Objet de la dépense</th>
                  <th>Km effectués</th>
                  <th>Péages / autres transports</th>
                  <th>Autres</th>
                  <th style="width: 32px"></th>
                </tr>
              </thead>
              <tbody id="depensesTbody"></tbody>
            </table>
          </div>
          <p class="bareme-line">
            Barème kilométrique : <strong>0,606 €/km</strong>
          </p>
          <button class="btn-add-row" onclick="addDepenseLine()">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path
                d="M7 2v10M2 7h10"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
            Ajouter une ligne
          </button>
          <div class="total-line">
            <span class="total-label">TOTAL des frais :</span>
            <span id="totalFraisDisplay">0,00 €</span>
          </div>
        </div>

        <!-- Section 3 : Choix -->
        <div class="invoice-form-section">
          <h3>Traitement des frais</h3>
          <div class="choix-group">
            <div
              class="choix-option"
              id="optAbandon"
              onclick="selectChoix('abandon')"
            >
              <input
                type="radio"
                name="choix"
                value="abandon"
                id="radioAbandon"
              />
              <label for="radioAbandon">
                <strong>Abandon des frais</strong>
                <p>
                  Il vous est possible de faire don au CST du total ou d'une
                  partie de cette somme. Dans ce cas, conformément à l'article
                  41 de la loi 2000-627 du 6 juillet 2000 modifiant la loi du 16
                  juillet 1984 relative à l'organisation et la promotion des
                  activités physiques et sportives, vous bénéficierez d'une
                  réduction d'impôts égale à 66&nbsp;% de la somme concernée
                  (dans la limite de 20&nbsp;% du revenu imposable). Un reçu
                  fiscal vous sera envoyé. <br /><em
                    >Attention le barême kilométrique est différent dans ce
                    cas.</em
                  >
                </p>
              </label>
            </div>
            <div
              class="choix-option"
              id="optRemboursement"
              onclick="selectChoix('remboursement')"
            >
              <input
                type="radio"
                name="choix"
                value="remboursement"
                id="radioRemboursement"
              />
              <label for="radioRemboursement">
                <strong>Remboursement</strong>
                <p>
                  Les frais vous seront remboursés sur le compte bancaire
                  indiqué ci-dessous.
                </p>
              </label>
            </div>
          </div>
          <div class="choix-extra" id="extraRemboursement">
            <div class="form-row cols-2" style="margin-top: 16px">
              <div>
                <label class="form-label">IBAN</label>
                <input
                  class="form-input"
                  type="text"
                  id="ibanInput"
                  placeholder="FR76 XXXX XXXX XXXX XXXX XXXX XXX"
                />
              </div>
              <div>
                <label class="form-label">BIC</label>
                <input
                  class="form-input"
                  type="text"
                  id="bicInput"
                  placeholder="XXXXXXXX"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Section 4 : Justificatifs -->
        <div class="invoice-form-section">
          <h3>Justificatifs</h3>
          <div
            class="upload-zone"
            id="uploadZone"
            onclick="document.getElementById('fileInput').click()"
            ondragover="handleDragOver(event)"
            ondragleave="handleDragLeave(event)"
            ondrop="handleDrop(event)"
          >
            <div class="upload-zone-icon">📎</div>
            <p><strong>Cliquez</strong> ou glissez vos fichiers ici</p>
            <p style="font-size: 0.75rem; margin-top: 4px; opacity: 0.7">
              PDF, JPG, PNG, HEIC… Nombre illimité
            </p>
          </div>
          <input
            type="file"
            id="fileInput"
            multiple
            accept="image/*,.pdf,.heic"
            style="display: none"
            onchange="handleFiles(this.files)"
          />
          <div class="upload-list" id="uploadList"></div>
          <div style="margin-top: 20px">
            <label class="form-label">📧 Envoyer la note de frais à</label>
            <input
              class="form-input"
              type="email"
              id="emailDestinataire"
              placeholder="tresorier@troglos.fr"
              style="margin-bottom: 6px"
            />
            <p
              style="
                font-size: 0.78rem;
                color: var(--ink-soft);
                line-height: 1.5;
              "
            >
              Laissez vide pour ne pas envoyer de mail. Les justificatifs seront
              joints automatiquement.
            </p>
          </div>
        </div>

        <!-- Section 5 : Signature -->
        <div class="invoice-form-section">
          <h3>Signature</h3>
          <div class="signature-zone">
            <canvas id="sigCanvas" width="780" height="140"></canvas>
            <div class="sig-controls">
              <button
                class="sig-btn active"
                id="sigModeSign"
                onclick="setSigMode('sign')"
              >
                ✍️ Signer
              </button>
              <button
                class="sig-btn"
                id="sigModeText"
                onclick="setSigMode('text')"
              >
                Aa Texte
              </button>
              <input
                type="text"
                id="sigTextInput"
                class="form-input"
                placeholder="Tapez votre nom…"
                style="
                  display: none;
                  flex: 1;
                  padding: 6px 12px;
                  font-size: 0.85rem;
                  border-radius: 6px;
                "
                oninput="renderTextSig()"
              />
              <button
                class="sig-btn"
                onclick="clearSig()"
                style="margin-left: auto"
              >
                🗑️ Effacer
              </button>
            </div>
          </div>
        </div>

        <button
          class="form-submit"
          onclick="doCreateInvoice()"
          style="margin-top: 8px"
        >
          ✓ Générer la note de frais
        </button>
        <div class="form-feedback" id="invoiceFeedback"></div>
      </div>
    </div>

    <!-- CONFIRM DELETE MODAL -->
    <div class="modal-overlay" id="deleteModal">
      <div class="modal modal-confirm">
        <div class="confirm-icon">🗑️</div>
        <h2>Supprimer la facture ?</h2>
        <p>
          Cette action est irréversible. La note de frais et tous ses
          justificatifs seront définitivement supprimés.
        </p>
        <div class="confirm-actions">
          <button class="btn-cancel" onclick="closeDeleteModal()">
            Annuler
          </button>
          <button class="btn-confirm-delete" id="confirmDeleteBtn">
            Supprimer
          </button>
        </div>
      </div>
    </div>

    <!-- LOADING -->
    <div class="loading-overlay" id="loadingOverlay">
      <div class="loading-spinner"></div>
      <p>Génération en cours…</p>
    </div>

    <!-- TOAST -->
    <div class="toast" id="toast"></div>

    <script>
      // ─── STATE ───────────────────────────────────────────────
      let currentUser = null;
      let invoices = [];
      let uploadedFiles = [];
      let depensesCount = 0;
      let pendingDeleteId = null;
      let sigMode = "sign"; // 'sign' | 'text'
      const BAREME_KM = 0.606;

      // ─── INIT ─────────────────────────────────────────────────
      function init() {
        renderHero();
        renderHeader();
        checkSession();
        initSignature();
        addDepenseLine(); // 1 ligne par défaut
      }

      async function checkSession() {
        const res = await fetch("/my-invoices", { credentials: "include" });
        if (res.ok) {
          const data = await res.json();
          const email = localStorage.getItem("factura_email");
          if (email) {
            currentUser = { email };
            onLogin(email, data);
          }
        }
      }

      // ─── HEADER / HERO ───────────────────────────────────────
      function renderHero() {
        const hero = document.getElementById("heroContent");
        if (currentUser) {
          const name = currentUser.email.split("@")[0];
          hero.innerHTML = `
      <div class="hero-eyebrow">Espace personnel</div>
      <h1>Bienvenue,<br><em>${name}</em></h1>
      <p>Créez et gérez vos notes de frais CST depuis cet espace sécurisé.</p>
      <div class="hero-cta">
        <button class="btn-primary" onclick="openInvoiceModal()">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Nouvelle note de frais
        </button>
      </div>`;
        } else {
          hero.innerHTML = `
      <div class="hero-eyebrow">Gestion de notes de frais — CST</div>
      <h1>Vos frais,<br><em>simplifiés.</em></h1>
      <p>Créez et transmettez vos notes de frais au trésorier du CST en quelques minutes.</p>
      <div class="hero-cta">
        <button class="btn-primary" onclick="openAuth('register')">Commencer</button>
        <button class="btn-secondary" onclick="openAuth('login')">Se connecter</button>
      </div>`;
        }
      }

      function renderHeader() {
        const avatar = document.getElementById("userAvatar");
        const label = document.getElementById("userBtnLabel");
        const dropdown = document.getElementById("userDropdown");
        if (currentUser) {
          avatar.textContent = currentUser.email[0].toUpperCase();
          label.textContent = currentUser.email.split("@")[0];
          dropdown.innerHTML = `
      <div class="dropdown-item" style="color:var(--ink-soft);font-size:0.8rem;cursor:default">${currentUser.email}</div>
      <div class="dropdown-divider"></div>
      <button class="dropdown-item" onclick="openInvoiceModal()">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M7.5 2.5v10M2.5 7.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Nouvelle note de frais
      </button>
      <div class="dropdown-divider"></div>
      <button class="dropdown-item danger" onclick="doLogout()">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M10 5l3 3-3 3M13 8H5.5M8 3H3v9h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Se déconnecter
      </button>`;
        } else {
          avatar.textContent = "?";
          label.textContent = "Mon compte";
          dropdown.innerHTML = `
      <button class="dropdown-item" onclick="openAuth('login')">Se connecter</button>
      <button class="dropdown-item" onclick="openAuth('register')">S'inscrire</button>`;
        }
      }

      document.getElementById("userBtn").addEventListener("click", (e) => {
        e.stopPropagation();
        document.getElementById("userDropdown").classList.toggle("open");
      });
      document.addEventListener("click", () =>
        document.getElementById("userDropdown").classList.remove("open"),
      );

      // ─── AUTH ─────────────────────────────────────────────────
      function openAuth(tab = "login") {
        document.getElementById("authModal").classList.add("open");
        document.getElementById("userDropdown").classList.remove("open");
        switchTab(tab);
      }
      function closeAuth() {
        document.getElementById("authModal").classList.remove("open");
      }
      document
        .getElementById("authModalClose")
        .addEventListener("click", closeAuth);
      document.getElementById("authModal").addEventListener("click", (e) => {
        if (e.target === e.currentTarget) closeAuth();
      });

      function switchTab(tab) {
        const isLogin = tab === "login";
        document.getElementById("loginForm").style.display = isLogin
          ? "block"
          : "none";
        document.getElementById("registerForm").style.display = isLogin
          ? "none"
          : "block";
        document.getElementById("tabLogin").classList.toggle("active", isLogin);
        document
          .getElementById("tabRegister")
          .classList.toggle("active", !isLogin);
        document.getElementById("authModalTitle").textContent = isLogin
          ? "Bienvenue"
          : "Créer un compte";
        document.getElementById("authModalSub").textContent = isLogin
          ? "Connectez-vous pour accéder à vos notes de frais."
          : "Rejoignez l'espace CST et gérez vos remboursements.";
      }

      async function doLogin() {
        const email = document.getElementById("loginEmail").value;
        const password = document.getElementById("loginPassword").value;
        const feedback = document.getElementById("loginFeedback");
        if (!email || !password) {
          feedback.textContent = "Veuillez remplir tous les champs.";
          return;
        }
        feedback.textContent = "";
        const res = await fetch("/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password }),
          credentials: "include",
        });
        const text = await res.text();
        if (text.includes("Connecté")) {
          localStorage.setItem("factura_email", email);
          currentUser = { email };
          closeAuth();
          onLogin(email, null);
          showToast("Connexion réussie 👋");
        } else {
          feedback.textContent =
            text === "Utilisateur introuvable"
              ? "Aucun compte avec cet email."
              : "Mot de passe incorrect.";
        }
      }

      async function doRegister() {
        const email = document.getElementById("regEmail").value;
        const password = document.getElementById("regPassword").value;
        const feedback = document.getElementById("registerFeedback");
        if (!email || !password) {
          feedback.textContent = "Veuillez remplir tous les champs.";
          return;
        }
        if (password.length < 6) {
          feedback.textContent = "Mot de passe trop court (6 caractères min).";
          return;
        }
        feedback.textContent = "";
        await fetch("/register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password }),
        });
        feedback.className = "form-feedback success";
        feedback.textContent = "Compte créé ! Connectez-vous.";
        setTimeout(() => switchTab("login"), 800);
      }

      async function onLogin(email, preloaded) {
        currentUser = { email };
        renderHero();
        renderHeader();
        if (!preloaded) {
          const res = await fetch("/my-invoices", { credentials: "include" });
          if (res.ok) invoices = await res.json();
        } else {
          invoices = preloaded;
        }
        renderInvoices();
        document.getElementById("invoicesSection").style.display = "block";
      }

      async function doLogout() {
        await fetch("/logout", { credentials: "include" });
        localStorage.removeItem("factura_email");
        currentUser = null;
        invoices = [];
        document.getElementById("invoicesSection").style.display = "none";
        renderHero();
        renderHeader();
        document.getElementById("userDropdown").classList.remove("open");
        showToast("Vous êtes déconnecté.");
      }

      // ─── INVOICE LIST ─────────────────────────────────────────
      function renderInvoices() {
        const grid = document.getElementById("invoiceGrid");
        if (invoices.length === 0) {
          grid.innerHTML = `<div class="empty-state"><div class="empty-state-icon">🗂️</div><h3>Aucune note de frais</h3><p>Cliquez sur « Nouvelle note de frais » pour commencer.</p></div>`;
          return;
        }
        grid.innerHTML = invoices
          .map((inv, i) => {
            const date = new Date(inv.createdAt);
            const dateStr = date.toLocaleDateString("fr-FR", {
              day: "2-digit",
              month: "long",
              year: "numeric",
            });
            const total = parseFloat(inv.totalFrais || 0).toLocaleString(
              "fr-FR",
              { minimumFractionDigits: 2 },
            );
            const choixLabel =
              inv.choix === "remboursement"
                ? "Remboursement"
                : inv.choix === "abandon"
                  ? "Don au CST"
                  : "—";
            const choixClass =
              inv.choix === "remboursement"
                ? "choix-remboursement"
                : "choix-abandon";
            return `
      <div class="invoice-card" style="animation-delay:${i * 0.06}s">
        <div class="invoice-card-header">
          <div class="invoice-icon">🧾</div>
          <button class="btn-delete-invoice" onclick="openDeleteModal('${inv._id}')" title="Supprimer">✕</button>
        </div>
        <div class="invoice-name">${inv.nomDemandeur || "—"}</div>
        ${inv.budget ? `<span class="invoice-budget">${inv.budget}</span>` : ""}
        <div class="invoice-total">${total}<span> €</span></div>
        <div class="invoice-id">Note #${String(inv._id).slice(-6)}</div>
        <div class="invoice-card-footer">
          <span class="invoice-date">${dateStr}</span>
          <div style="display:flex;align-items:center;gap:8px">
            <span class="invoice-choix ${choixClass}">${choixLabel}</span>
            <a href="/invoice/${inv._id}/preview" target="_blank"
              style="font-size:0.75rem;font-weight:600;color:var(--gold);text-decoration:none;
              background:rgba(201,168,76,0.1);border:1px solid var(--gold-light);border-radius:20px;
              padding:3px 10px;transition:all 0.2s;white-space:nowrap"
              onmouseover="this.style.background='var(--gold)';this.style.color='var(--ink)'"
              onmouseout="this.style.background='rgba(201,168,76,0.1)';this.style.color='var(--gold)'">
              🖨️ Aperçu
            </a>
          </div>
        </div>
      </div>`;
          })
          .join("");
      }

      // ─── DELETE ───────────────────────────────────────────────
      function openDeleteModal(id) {
        pendingDeleteId = id;
        document.getElementById("deleteModal").classList.add("open");
      }
      function closeDeleteModal() {
        pendingDeleteId = null;
        document.getElementById("deleteModal").classList.remove("open");
      }
      document.getElementById("deleteModal").addEventListener("click", (e) => {
        if (e.target === e.currentTarget) closeDeleteModal();
      });
      document
        .getElementById("confirmDeleteBtn")
        .addEventListener("click", async () => {
          if (!pendingDeleteId) return;
          const res = await fetch("/invoice/" + pendingDeleteId, {
            method: "DELETE",
            credentials: "include",
          });
          const data = await res.json();
          if (data.ok) {
            invoices = invoices.filter((inv) => inv._id !== pendingDeleteId);
            renderInvoices();
            showToast("Note de frais supprimée.");
          } else {
            showToast("Erreur : " + data.error);
          }
          closeDeleteModal();
        });

      // ─── INVOICE FORM ─────────────────────────────────────────
      function openInvoiceModal() {
        document.getElementById("invoiceModal").classList.add("open");
        document.getElementById("userDropdown").classList.remove("open");
        document.getElementById("invoiceFeedback").textContent = "";
      }
      function closeInvoiceModal() {
        document.getElementById("invoiceModal").classList.remove("open");
      }
      document
        .getElementById("invoiceModalClose")
        .addEventListener("click", closeInvoiceModal);
      document.getElementById("invoiceModal").addEventListener("click", (e) => {
        if (e.target === e.currentTarget) closeInvoiceModal();
      });
      document
        .getElementById("btnGenerateInvoice")
        .addEventListener("click", openInvoiceModal);

      // DÉPENSES TABLE
      function addDepenseLine() {
        depensesCount++;
        const id = depensesCount;
        const tr = document.createElement("tr");
        tr.id = "depense-row-" + id;
        tr.innerHTML = `
    <td><input type="date" data-field="dateDepense" data-row="${id}"/></td>
    <td><input type="text" placeholder="Ex : carburant" data-field="objetDepense" data-row="${id}"/></td>
    <td class="km-col"><input type="number" min="0" step="1" placeholder="0" data-field="km" data-row="${id}" oninput="recalcTotal()"/></td>
    <td><input type="number" min="0" step="0.01" placeholder="0,00" data-field="peages" data-row="${id}" oninput="recalcTotal()"/></td>
    <td><input type="number" min="0" step="0.01" placeholder="0,00" data-field="autres" data-row="${id}" oninput="recalcTotal()"/></td>
    <td><button class="btn-remove-row" onclick="removeDepenseLine(${id})" title="Supprimer">✕</button></td>`;
        document.getElementById("depensesTbody").appendChild(tr);
        recalcTotal();
      }

      function removeDepenseLine(id) {
        const row = document.getElementById("depense-row-" + id);
        if (row) row.remove();
        recalcTotal();
      }

      function recalcTotal() {
        const rows = document.querySelectorAll("#depensesTbody tr");
        let total = 0;
        rows.forEach((row) => {
          const km = parseFloat(
            row.querySelector('[data-field="km"]')?.value || 0,
          );
          const peages = parseFloat(
            row.querySelector('[data-field="peages"]')?.value || 0,
          );
          const autres = parseFloat(
            row.querySelector('[data-field="autres"]')?.value || 0,
          );
          total += km * BAREME_KM + peages + autres;
        });
        document.getElementById("totalFraisDisplay").textContent =
          total.toLocaleString("fr-FR", { minimumFractionDigits: 2 }) + " €";
        return total;
      }

      function getLignes() {
        const rows = document.querySelectorAll("#depensesTbody tr");
        return Array.from(rows).map((row) => ({
          dateDepense:
            row.querySelector('[data-field="dateDepense"]')?.value || "",
          objetDepense:
            row.querySelector('[data-field="objetDepense"]')?.value || "",
          km: parseFloat(row.querySelector('[data-field="km"]')?.value || 0),
          peages: parseFloat(
            row.querySelector('[data-field="peages"]')?.value || 0,
          ),
          autres: parseFloat(
            row.querySelector('[data-field="autres"]')?.value || 0,
          ),
        }));
      }

      // CHOIX
      function selectChoix(val) {
        document.getElementById("radioAbandon").checked = val === "abandon";
        document.getElementById("radioRemboursement").checked =
          val === "remboursement";
        document
          .getElementById("optAbandon")
          .classList.toggle("selected", val === "abandon");
        document
          .getElementById("optRemboursement")
          .classList.toggle("selected", val === "remboursement");
        document
          .getElementById("extraRemboursement")
          .classList.toggle("visible", val === "remboursement");
      }

      // UPLOAD
      function handleDragOver(e) {
        e.preventDefault();
        document.getElementById("uploadZone").classList.add("dragover");
      }
      function handleDragLeave() {
        document.getElementById("uploadZone").classList.remove("dragover");
      }
      function handleDrop(e) {
        e.preventDefault();
        document.getElementById("uploadZone").classList.remove("dragover");
        handleFiles(e.dataTransfer.files);
      }
      function handleFiles(fileList) {
        for (const f of fileList) {
          uploadedFiles.push(f);
        }
        renderUploadList();
      }
      function removeFile(idx) {
        uploadedFiles.splice(idx, 1);
        renderUploadList();
      }
      function renderUploadList() {
        const list = document.getElementById("uploadList");
        list.innerHTML = uploadedFiles
          .map(
            (f, i) => `
    <div class="upload-item">
      <span style="font-size:1rem">${f.type.includes("pdf") ? "📄" : "🖼️"}</span>
      <span class="upload-item-name">${f.name}</span>
      <span class="upload-item-size">${(f.size / 1024).toFixed(0)} Ko</span>
      <button class="btn-remove-file" onclick="removeFile(${i})">✕</button>
    </div>`,
          )
          .join("");
      }

      // SIGNATURE
      let sigCanvas,
        sigCtx,
        sigDrawing = false,
        sigLastX,
        sigLastY;
      function initSignature() {
        sigCanvas = document.getElementById("sigCanvas");
        sigCtx = sigCanvas.getContext("2d");
        sigCtx.strokeStyle = "#1a1714";
        sigCtx.lineWidth = 2;
        sigCtx.lineCap = "round";
        sigCtx.lineJoin = "round";
        sigCanvas.addEventListener("mousedown", (e) => {
          sigDrawing = true;
          const p = getSigPos(e);
          sigLastX = p.x;
          sigLastY = p.y;
        });
        sigCanvas.addEventListener("mousemove", (e) => {
          if (!sigDrawing) return;
          drawSig(getSigPos(e));
        });
        sigCanvas.addEventListener("mouseup", () => (sigDrawing = false));
        sigCanvas.addEventListener("mouseleave", () => (sigDrawing = false));
        sigCanvas.addEventListener("touchstart", (e) => {
          e.preventDefault();
          sigDrawing = true;
          const p = getSigPos(e.touches[0]);
          sigLastX = p.x;
          sigLastY = p.y;
        });
        sigCanvas.addEventListener("touchmove", (e) => {
          e.preventDefault();
          if (!sigDrawing) return;
          drawSig(getSigPos(e.touches[0]));
        });
        sigCanvas.addEventListener("touchend", () => (sigDrawing = false));
      }
      function getSigPos(e) {
        const rect = sigCanvas.getBoundingClientRect();
        const scaleX = sigCanvas.width / rect.width;
        const scaleY = sigCanvas.height / rect.height;
        return {
          x: (e.clientX - rect.left) * scaleX,
          y: (e.clientY - rect.top) * scaleY,
        };
      }
      function drawSig(pos) {
        sigCtx.beginPath();
        sigCtx.moveTo(sigLastX, sigLastY);
        sigCtx.lineTo(pos.x, pos.y);
        sigCtx.stroke();
        sigLastX = pos.x;
        sigLastY = pos.y;
      }
      function clearSig() {
        sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
        document.getElementById("sigTextInput").value = "";
      }
      function setSigMode(mode) {
        sigMode = mode;
        document
          .getElementById("sigModeSign")
          .classList.toggle("active", mode === "sign");
        document
          .getElementById("sigModeText")
          .classList.toggle("active", mode === "text");
        document.getElementById("sigTextInput").style.display =
          mode === "text" ? "block" : "none";
        sigCanvas.style.pointerEvents = mode === "sign" ? "auto" : "none";
        if (mode === "text") renderTextSig();
      }
      function renderTextSig() {
        const text = document.getElementById("sigTextInput").value;
        sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
        if (!text) return;
        sigCtx.font = 'italic 38px "Playfair Display", serif';
        sigCtx.fillStyle = "#1a1714";
        sigCtx.fillText(text, 24, 90);
      }

      // CREATE INVOICE
      async function doCreateInvoice() {
        const nomDemandeur = document
          .getElementById("nomDemandeur")
          .value.trim();
        const dateDemande = document.getElementById("dateDemande").value;
        const raisonDepense = document
          .getElementById("raisonDepense")
          .value.trim();
        const budget = document.getElementById("budget").value;
        const choix = document.querySelector(
          'input[name="choix"]:checked',
        )?.value;
        const feedback = document.getElementById("invoiceFeedback");

        if (!nomDemandeur) {
          feedback.textContent = "Veuillez saisir le nom du demandeur.";
          return;
        }
        if (!choix) {
          feedback.textContent =
            "Veuillez choisir entre abandon des frais et remboursement.";
          return;
        }
        if (choix === "remboursement") {
          const iban = document.getElementById("ibanInput").value.trim();
          if (!iban) {
            feedback.textContent = "Veuillez saisir votre IBAN.";
            return;
          }
        }

        feedback.textContent = "";
        document.getElementById("loadingOverlay").classList.add("open");

        try {
          const lignes = getLignes();
          const totalFrais = recalcTotal();
          const signature = sigCanvas.toDataURL("image/png");
          const iban = document.getElementById("ibanInput").value.trim();
          const bic = document.getElementById("bicInput").value.trim();
          const emailDestinataire = document
            .getElementById("emailDestinataire")
            .value.trim();

          const formData = new FormData();
          formData.append("nomDemandeur", nomDemandeur);
          formData.append("dateDemande", dateDemande);
          formData.append("raisonDepense", raisonDepense);
          formData.append("budget", budget);
          formData.append("lignes", JSON.stringify(lignes));
          formData.append("totalFrais", totalFrais.toString());
          formData.append("choix", choix);
          if (choix === "abandon") {
            formData.append("montantAbandon", totalFrais.toString());
          }
          if (iban) formData.append("iban", iban);
          if (bic) formData.append("bic", bic);
          if (emailDestinataire)
            formData.append("emailDestinataire", emailDestinataire);
          formData.append("signature", signature);
          for (const f of uploadedFiles) {
            formData.append("justificatifs", f);
          }

          const res = await fetch("/invoice", {
            method: "POST",
            body: formData,
            credentials: "include",
          });
          const data = await res.json();

          if (data.ok) {
            const refresh = await fetch("/my-invoices", {
              credentials: "include",
            });
            invoices = await refresh.json();
            renderInvoices();
            closeInvoiceModal();
            const toastMsg = emailDestinataire
              ? `Note de frais envoyée à ${emailDestinataire} ✓`
              : "Note de frais créée avec succès ✓";
            showToast(toastMsg);
            // Reset form
            uploadedFiles = [];
            renderUploadList();
            document.getElementById("depensesTbody").innerHTML = "";
            depensesCount = 0;
            addDepenseLine();
            clearSig();
            selectChoix("");
          } else {
            feedback.textContent = "Erreur : " + (data.error || "inconnue");
          }
        } catch (err) {
          feedback.textContent = "Erreur réseau : " + err.message;
        } finally {
          document.getElementById("loadingOverlay").classList.remove("open");
        }
      }

      // ─── TOAST ────────────────────────────────────────────────
      function showToast(msg) {
        const t = document.getElementById("toast");
        t.textContent = msg;
        t.classList.add("show");
        setTimeout(() => t.classList.remove("show"), 3000);
      }

      init();
    </script>
  </body>
</html>
